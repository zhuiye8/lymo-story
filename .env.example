# LLM Configuration
STORY_LITELLM_MODEL=gpt-4o
STORY_LITELLM_API_KEY=sk-your-key-here
# Optional: custom API base (e.g., for local models or proxies)
# STORY_LITELLM_API_BASE=http://localhost:8080/v1

# Storage paths (defaults work for local dev)
# STORY_SQLITE_PATH=data/story.db
# STORY_CHECKPOINT_DB_PATH=data/checkpoints.db
# STORY_DATA_DIR=data/stories
# STORY_CHROMA_PATH=data/chroma

# Semantic memory embedding
#   default = ChromaDB built-in all-MiniLM (CPU, English-centric — weak Chinese ranking)
#   ollama  = local Qwen3-Embedding via ollama (GPU, Chinese SOTA — recommended for 中文)
#     prereq: install ollama + `ollama pull qwen3-embedding:4b` (2.5GB, needs a GPU)
#             `pip install ollama` (lightweight HTTP client)
# STORY_EMBED_PROVIDER=ollama
# STORY_EMBED_MODEL=qwen3-embedding:4b
# STORY_OLLAMA_BASE_URL=http://localhost:11434

# Generation parameters
# STORY_MAX_CONSISTENCY_RETRIES=3
# STORY_DEFAULT_CHAPTER_WORD_COUNT=3000
